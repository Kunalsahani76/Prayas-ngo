# Safe to expose in the browser; this is the Cloudinary product environment name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=rbecxwqa

# Server-only credentials. Get both values from Cloudinary's API Keys page.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing signed preset shown in the Cloudinary dashboard screenshot.
CLOUDINARY_RESUME_UPLOAD_PRESET=volunteer_resumes
